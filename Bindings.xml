<?xml version="1.0" encoding="UTF-8"?>
<Bindings>
    <!-- ============================================================ -->
    <!-- ConsoleMode - Vanilla                                        -->
    <!-- Bindings de Ação: 5 páginas x 8 botões = 40 slots           -->
    <!-- Página 1: Sem Modificador (Base)                             -->
    <!-- Página 2: L2  = SHIFT                                        -->
    <!-- Página 3: R1  = CTRL                                         -->
    <!-- Página 4: R2  = ALT                                          -->
    <!-- Página 5: L2+R2 = SHIFT+ALT                                  -->
    <!-- ============================================================ -->

    <!-- PAGE 1: Base (sem modificador) -->
    <!-- Faciais -->
    <Binding name="CM_ACTION_A_1" header="CONSOLEMODEBASE">CM_Action("A", 1)</Binding>
    <Binding name="CM_ACTION_X_1">CM_Action("X", 1)</Binding>
    <Binding name="CM_ACTION_Y_1">CM_Action("Y", 1)</Binding>
    <Binding name="CM_ACTION_B_1">CM_Action("B", 1)</Binding>
    <!-- D-Pad Hotkey -->
    <Binding name="CM_ACTION_DUP_1">CM_Action("DUP", 1)</Binding>
    <Binding name="CM_ACTION_DDOWN_1">CM_Action("DDOWN", 1)</Binding>
    <Binding name="CM_ACTION_DLEFT_1">CM_Action("DLEFT", 1)</Binding>
    <Binding name="CM_ACTION_DRIGHT_1">CM_Action("DRIGHT", 1)</Binding>

    <!-- PAGE 2: L2 = SHIFT -->
    <Binding name="CM_ACTION_A_2" header="CONSOLEMMODEL2">CM_Action("A", 2)</Binding>
    <Binding name="CM_ACTION_X_2">CM_Action("X", 2)</Binding>
    <Binding name="CM_ACTION_Y_2">CM_Action("Y", 2)</Binding>
    <Binding name="CM_ACTION_B_2">CM_Action("B", 2)</Binding>
    <Binding name="CM_ACTION_DUP_2">CM_Action("DUP", 2)</Binding>
    <Binding name="CM_ACTION_DDOWN_2">CM_Action("DDOWN", 2)</Binding>
    <Binding name="CM_ACTION_DLEFT_2">CM_Action("DLEFT", 2)</Binding>
    <Binding name="CM_ACTION_DRIGHT_2">CM_Action("DRIGHT", 2)</Binding>

    <!-- PAGE 3: R1 = CTRL -->
    <Binding name="CM_ACTION_A_3" header="CONSOLEMODER1">CM_Action("A", 3)</Binding>
    <Binding name="CM_ACTION_X_3">CM_Action("X", 3)</Binding>
    <Binding name="CM_ACTION_Y_3">CM_Action("Y", 3)</Binding>
    <Binding name="CM_ACTION_B_3">CM_Action("B", 3)</Binding>
    <Binding name="CM_ACTION_DUP_3">CM_Action("DUP", 3)</Binding>
    <Binding name="CM_ACTION_DDOWN_3">CM_Action("DDOWN", 3)</Binding>
    <Binding name="CM_ACTION_DLEFT_3">CM_Action("DLEFT", 3)</Binding>
    <Binding name="CM_ACTION_DRIGHT_3">CM_Action("DRIGHT", 3)</Binding>

    <!-- PAGE 4: R2 = ALT -->
    <Binding name="CM_ACTION_A_4" header="CONSOLEMODER2">CM_Action("A", 4)</Binding>
    <Binding name="CM_ACTION_X_4">CM_Action("X", 4)</Binding>
    <Binding name="CM_ACTION_Y_4">CM_Action("Y", 4)</Binding>
    <Binding name="CM_ACTION_B_4">CM_Action("B", 4)</Binding>
    <Binding name="CM_ACTION_DUP_4">CM_Action("DUP", 4)</Binding>
    <Binding name="CM_ACTION_DDOWN_4">CM_Action("DDOWN", 4)</Binding>
    <Binding name="CM_ACTION_DLEFT_4">CM_Action("DLEFT", 4)</Binding>
    <Binding name="CM_ACTION_DRIGHT_4">CM_Action("DRIGHT", 4)</Binding>

    <!-- PAGE 5: L2+R2 = SHIFT+ALT -->
    <Binding name="CM_ACTION_A_5" header="CONSOLEMODEL2R2">CM_Action("A", 5)</Binding>
    <Binding name="CM_ACTION_X_5">CM_Action("X", 5)</Binding>
    <Binding name="CM_ACTION_Y_5">CM_Action("Y", 5)</Binding>
    <Binding name="CM_ACTION_B_5">CM_Action("B", 5)</Binding>
    <Binding name="CM_ACTION_DUP_5">CM_Action("DUP", 5)</Binding>
    <Binding name="CM_ACTION_DDOWN_5">CM_Action("DDOWN", 5)</Binding>
    <Binding name="CM_ACTION_DLEFT_5">CM_Action("DLEFT", 5)</Binding>
    <Binding name="CM_ACTION_DRIGHT_5">CM_Action("DRIGHT", 5)</Binding>

    <!-- ============================================================ -->
    <!-- Botões Fixos e Atalhos de Interface                          -->
    <!-- ============================================================ -->
    <Binding name="CM_SMART_TAB" header="CONSOLEMODEFIXED">CM_SmartTab()</Binding>      <!-- TAB / L1: Target em combate / Aba anterior em menus -->
    <Binding name="CM_FIXED_SELECT">CM_Fixed("SELECT")</Binding>                         <!-- Mapa (base) -->
    <Binding name="CM_FIXED_START">CM_Fixed("START")</Binding>                           <!-- Menu (base) -->
    <Binding name="CM_TOGGLE_MOUSEMODE">CM_ToggleMouseMode()</Binding>                   <!-- L3 -->
    <Binding name="CM_MOUSERIGHT">CM_MouseRight()</Binding>                              <!-- R3 -->

    <!-- ============================================================ -->
    <!-- Atalhos de Interface Rápidos com Combos                      -->
    <!-- ============================================================ -->
    <Binding name="CM_UI_CHARACTER" header="CONSOLEMODEUI">CM_ToggleUI("Character")</Binding> <!-- C = L2 + Select -->
    <Binding name="CM_UI_BAGS">CM_ToggleUI("Bags")</Binding>                                   <!-- B = L2 + Start -->
    <Binding name="CM_UI_TALENTS">CM_ToggleUI("Talents")</Binding>                             <!-- N = R2 + Select -->
    <Binding name="CM_UI_SPELLBOOK">CM_ToggleUI("SpellBook")</Binding>                         <!-- P = R2 + Start -->
    <Binding name="CM_INTERACT" header="CONSOLEMODEINTERACT">CM_Interact(0)</Binding>           <!-- R2 + A: Interagir (Interact.dll) -->
    <Binding name="CM_INTERACT_AUTOLOOT">CM_Interact(1)</Binding>                               <!-- Interagir com Auto-Loot -->

    <!-- ============================================================ -->
    <!-- Menu Ring (L2 + R2 + A)                                     -->
    <!-- Abre o menu radial de ações rápidas                         -->
    <!-- Implementação: FUTURA                                        -->
    <!-- ============================================================ -->
    <Binding name="CM_RING_MENU" header="CONSOLEMODERING">CM_OpenRingMenu()</Binding>

    <!-- ============================================================ -->
    <!-- Navegação de Cursor UI (D-Pad modo navegação)                -->
    <!-- ============================================================ -->
    <Binding name="CM_CURSOR_UP" header="CONSOLEMODECURSOR" runOnUp="true">CM_CursorMove("UP", keystate)</Binding>
    <Binding name="CM_CURSOR_DOWN" runOnUp="true">CM_CursorMove("DOWN", keystate)</Binding>
    <Binding name="CM_CURSOR_LEFT" runOnUp="true">CM_CursorMove("LEFT", keystate)</Binding>
    <Binding name="CM_CURSOR_RIGHT" runOnUp="true">CM_CursorMove("RIGHT", keystate)</Binding>
    <Binding name="CM_CURSOR_CONFIRM">CM_CursorConfirm()</Binding>                       <!-- A no modo nav (Selecionar/Clicar) -->
    <Binding name="CM_CURSOR_CANCEL">CM_CursorCancel()</Binding>                         <!-- B no modo nav (Fechar/Cancelar) -->
    <Binding name="CM_CURSOR_USE">CM_CursorUse()</Binding>                               <!-- Y no modo nav (Usar Item / Botao Direito) -->
    <Binding name="CM_CURSOR_SECONDARY">CM_CursorSecondary()</Binding>                   <!-- X no modo nav (Acao Secundaria / Dividir) -->
    <Binding name="CM_NAV_PREV_TAB">CM_NavPrevTab()</Binding>                           <!-- L1/LB: Aba Anterior -->
    <Binding name="CM_NAV_NEXT_TAB">CM_NavNextTab()</Binding>                           <!-- R1/RB: Proxima Aba -->
    <Binding name="CM_MODEL_ROTATE_LEFT" header="CONSOLEMODECURSOR" hidden="true" runOnUp="true">CM_ModelRotateLeft(keystate)</Binding>
    <Binding name="CM_MODEL_ROTATE_RIGHT" header="CONSOLEMODECURSOR" hidden="true" runOnUp="true">CM_ModelRotateRight(keystate)</Binding>
    <Binding name="CM_MAP_UP" header="CONSOLEMODECURSOR" hidden="true" runOnUp="true">CM_MapPanStick("UP", keystate)</Binding>
    <Binding name="CM_MAP_DOWN" header="CONSOLEMODECURSOR" hidden="true" runOnUp="true">CM_MapPanStick("DOWN", keystate)</Binding>
    <Binding name="CM_MAP_LEFT" header="CONSOLEMODECURSOR" hidden="true" runOnUp="true">CM_MapPanStick("LEFT", keystate)</Binding>
    <Binding name="CM_MAP_RIGHT" header="CONSOLEMODECURSOR" hidden="true" runOnUp="true">CM_MapPanStick("RIGHT", keystate)</Binding>

    <!-- ============================================================ -->
    <!-- Smart Mouse Look Companion (F9 via Steam Input)              -->
    <!-- ============================================================ -->
    <Binding name="CM_MOUSELOOK_START" hidden="true">CM_MouseLookStart()</Binding>
    <Binding name="CM_MOUSELOOK_STOP" hidden="true">CM_MouseLookStop()</Binding>
</Bindings>
